# Konfiguracja serwera. Skopiuj do `.env` i uzupełnij.
# Sekrety generuj losowo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Serwer waliduje środowisko na starcie i ODMAWIA URUCHOMIENIA, gdy brakuje
# DATABASE_URL lub JWT_SECRET, albo gdy sekret ma < 32 znaki.
# Wszystko poza sekcją „WYMAGANE" jest opcjonalne — przy każdej zmiennej jest
# napisane, co przestaje działać bez niej.

# ═══ WYMAGANE ════════════════════════════════════════════════════════════════

# Połączenie do bazy używane w runtime (na hostingu zwykle pooled).
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Połączenie BEZPOŚREDNIE (non-pooled) do `prisma migrate deploy` — advisory lock
# nie przechodzi przez pgBouncera (błąd P1002). Lokalnie: to samo co DATABASE_URL.
# Na hostingach z wbudowanym poolerem: ten sam adres, ale host bez członu poolera —
# sprawdź w dokumentacji swojego dostawcy, jak wygląda połączenie bezpośrednie.
DIRECT_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Podpisywanie tokenów JWT. Min. 32 znaki.
JWT_SECRET=""

# ═══ PODSTAWY ════════════════════════════════════════════════════════════════

PORT=3000
NODE_ENV="development"

# Adres frontu — używany w linkach w e-mailach, jako dozwolony origin CORS oraz jako
# adres kanoniczny w meta OG i w sitemapie. Na produkcji USTAW swój publiczny adres.
CLIENT_URL="http://localhost:5173"

# Nadpisuje CLIENT_URL w linkach e-mail (przydatne, gdy front stoi pod inną domeną
# niż ta, z której korzysta CORS). Puste = używany jest CLIENT_URL.
FRONTEND_URL=""

# Dodatkowe originy CORS po przecinku — np. adres z LAN-u, żeby wejść z telefonu:
#   CORS_ALLOWED_ORIGINS="http://192.168.0.10:5173,https://moja-domena.pl"
# Front woła API bezpośrednio (nie przez proxy Vite), więc każdy inny port niż
# 5173/5174 musi tu trafić, inaczej przeglądarka zablokuje zapytania.
CORS_ALLOWED_ORIGINS=""

# ═══ FUNKCJE AI (BYOK) ═══════════════════════════════════════════════════════

# Klucz do szyfrowania kluczy API użytkowników (AES-256-GCM). Dokładnie 64 znaki hex.
# Brak zmiennej  = funkcje AI wyłączone, aplikacja startuje normalnie.
# Zły format     = serwer przerywa start (cichy fallback psułby każdy zapis).
# Instancja NIE ma własnego klucza do modeli — każdy użytkownik podaje swój (BYOK).
# UWAGA: zmiana tej wartości unieważnia WSZYSTKIE zapisane klucze użytkowników.
AI_KEY_ENCRYPTION_KEY=""

# ═══ NOTOWANIA (dane rynkowe) ════════════════════════════════════════════════

# Dostawca notowań akcji / ETF-ów / indeksów / krypto.
#
# TO REPOZYTORIUM NIE ZAWIERA ŻADNEGO DOSTAWCY NOTOWAŃ. Jedyna wbudowana wartość to
# ""/"none": wartość rynkową pozycji wpisujesz ręcznie („Wpisz ceny" w Portfelu),
# a aplikacja nie odpytuje w tej sprawie nikogo z zewnątrz. Cokolwiek innego tu
# wpiszesz, fasada i tak spadnie na "none" i ostrzeże w logu.
#
# Chcesz notowania live? Dopisz własny adapter — instrukcja w nagłówku pliku
# `apps/server/src/services/marketData/index.ts` (jeden plik + wpis w mapie).
# Sprawdź przy tym warunki licencyjne źródła, z którego chcesz korzystać.
#
# Cena złota i kursy walut idą z NBP (oficjalne publiczne API bez klucza) i działają
# NIEZALEŻNIE od tej zmiennej.
#
# Skutki braku dostawcy: cron notowań odświeża tylko złoto, a przycisk „Odśwież ceny"
# i wyszukiwarka instrumentów są ukryte w interfejsie.
MARKET_DATA_PROVIDER=""

# ═══ E-MAIL (Resend) ═════════════════════════════════════════════════════════
# Bez tego nie wyjdą maile weryfikacyjne ani resety hasła. Rejestracja i tak się
# powiedzie — konto potwierdzisz ręcznie w bazie:
#   UPDATE users SET "isEmailVerified"=true WHERE email='…';

RESEND_API_KEY=""
# Nadawca. Domena musi być zweryfikowana w Resendzie.
RESEND_FROM_EMAIL="SmartPortfel <no-reply@example.com>"
# Adres kontaktowy pokazywany użytkownikom: trafiają tam odpowiedzi na maile
# z aplikacji (`reply_to`), jest też podany w treści maila powitalnego.
# PUSTE = maile wychodzą bez `reply_to`, a zdanie z adresem się nie pojawia.
REPLY_TO_EMAIL=""
# Adres administratora TEJ instancji — powiadomienia o nowych rejestracjach
# i zgłoszenia z formularza feedbacku. PUSTE = te dwa maile nie są wysyłane
# (weryfikacja e-maila, reset hasła i zaproszenia działają niezależnie).
ADMIN_NOTIFICATION_EMAIL=""

# ═══ MCP (dostęp do danych z klienta MCP) ════════════════════════════════════

# Publiczny adres TEJ instancji (np. https://twoja-domena.pl) — trafia do metadanych
# OAuth serwera MCP, stąd klienci (Perplexity, Claude.ai-web) discover'ują autoryzację.
# PUSTE = OAuth dla MCP jest wyłączony (serwer wypisze ostrzeżenie przy starcie).
# Tokeny MCP generowane ręcznie w Ustawieniach działają niezależnie od tej zmiennej.
MCP_OAUTH_ISSUER=""

# ═══ ZADANIA OKRESOWE ════════════════════════════════════════════════════════

# Bearer chroniący endpointy cron (aktualizacja notowań, uzgadnianie sald).
CRON_SECRET=""

# Bearer chroniący endpoint porządkowy (usuwanie wygasłych tokenów itp.).
SYSTEM_CLEANUP_TOKEN=""


# ═══ SKRYPTY POMOCNICZE ══════════════════════════════════════════════════════

# Konto demo z przykładowymi danymi:
#   NODE_ENV=development DEMO_USER_EMAIL=… DEMO_USER_PASSWORD=… \
#     npx ts-node -T src/scripts/seed-demo.ts
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""
DEMO_USER_NAME=""
