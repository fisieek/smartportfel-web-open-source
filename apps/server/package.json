{
  "name": "@smartportfel/server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "PRISMA_CLIENT_ENGINE_TYPE=library nodemon --exec npx ts-node -T src/index.ts",
    "build": "echo '--- Starting Server Build ---' && rm -rf dist && echo '--- Generating Prisma Client ---' && npx prisma generate && echo '--- Compiling TypeScript ---' && cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc && echo '--- Build Finished ---'",
    "db:deploy": "npx prisma migrate deploy",
    "start": "node dist/index.js",
    "postinstall": "npx prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "@smartportfel/contracts": "workspace:*",
    "@smartportfel/shared": "workspace:*",
    "ai": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.16.3",
    "prisma": "^5.22.0",
    "resend": "^3.5.0",
    "unpdf": "^1.6.2",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^2.1.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}